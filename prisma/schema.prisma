generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserPreference {
  id        String @id @default(cuid())
  userId    String
  type      String
  channel   String
  enabled   Boolean
  @@unique([userId, type, channel])
}

model QuietHours {
  id        String @id @default(cuid())
  userId    String @unique
  startHour Int
  endHour   Int
  timezone  String
}

model GlobalPolicy {
  id        String @id @default(cuid())
  region    String
  type      String
  channel   String
  blocked   Boolean
  @@unique([region, type, channel])
}
